@model List<BookHive.Models.Book>

@{
    ViewData["Title"] = "Knygos";
}

<h1>Knygų paieška</h1>

<form asp-controller="Books" asp-action="Index" method="get" class="search-form">
    <input
        type="text"
        name="query"
        value="@Context.Request.Query["query"]"
        placeholder="Ieškoti knygos..."
        class="search-input" />
    <button type="submit" class="search-button">Ieškoti</button>

    <div class="search-options">
        <select name="genre">
            <option value="">Visi žanrai</option>
            @foreach (var g in Enum.GetValues<BookHive.Models.Genre>())
            {
                <option value="@g">@g</option>
            }
        </select>

        <select name="sortBy">
            <option value="">Numatyta tvarka</option>
            <option value="year">Pagal metus</option>
            <option value="title">Pagal pavadinimą</option>
        </select>
    </div>
</form>

@if (Model.Count == 0)
{
    <p>Nieko nerasta. Pabandyk paiešką.</p>
}
else
{
    @foreach (var book in Model)
{
    <div class="book-card">
        <div class="book-info">
            <h3>@book.Title</h3>
            <p>Autorius: @book.Author</p>
            <p>Metai: @book.FirstPublishYear</p>
            <p>Žanras: @book.Genre</p>
        </div>
        <img src="@book.Cover.Url" alt="@book.Title viršelis" class="book-cover" />
    </div>
}
}