@{
    ViewData["Title"] = "Knygos";
}
@section Styles {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<h1>Book Search</h1>

<form id="searchForm" class="search-form">
    <input
        type="text"
        id="queryInput"
        name="query"
        placeholder="Search for books..."
        class="search-input" />
    <button type="submit" class="search-button">Search</button>

    <div class="search-options">
        <div class="dropdown-filter" id="genreDropdown">
            <button type="button" class="dropdown-toggle" id="genreDropdownToggle">
                Genres <span id="genreCount"></span>
            </button>
            <div class="dropdown-menu" id="genreDropdownMenu">
                @foreach (var g in Enum.GetValues<BookHive.Models.Genre>())
                {
                    <label class="dropdown-item">
                        <input type="checkbox" class="genre-checkbox" value="@g" />
                        @g
                    </label>
                }
            </div>
        </div>

        <div class="sort-wrapper">
            <select name="sortBy" id="sortBySelect">
                <option value="">Default Order</option>
                <option value="title_asc">Title (A–Z)</option>
                <option value="title_desc">Title (Z–A)</option>
                <option value="year_asc">Year (Oldest First)</option>
                <option value="year_desc">Year (Newest First)</option>
            </select>
        </div>
    
    </div>
</form>

<div id="results">
    <p>Enter a search term.</p>
</div>

<script src="~/js/books.js" asp-append-version="true"></script>