@{
    ViewData["Title"] = "Knygos";
}

<h1>Knygų paieška</h1>

<form id="searchForm" class="search-form">
    <input
        type="text"
        id="queryInput"
        name="query"
        placeholder="Ieškoti knygos..."
        class="search-input" />
    <button type="submit" class="search-button">Ieškoti</button>

    <div class="search-options">
        <div class="dropdown-filter" id="genreDropdown">
            <button type="button" class="dropdown-toggle" id="genreDropdownToggle">
                Žanrai <span id="genreCount"></span>
            </button>
            <div class="dropdown-menu" id="genreDropdownMenu">
                @foreach (var g in Enum.GetValues<BookHive.Models.Genre>())
                {
                    <label class="dropdown-item">
                        <input type="checkbox" class="genre-checkbox" value="@g" />
                        @g
                    </label>
                }
            </div>
        </div>

        <div class="sort-wrapper">
            <select name="sortBy" id="sortBySelect">
                <option value="">Numatyta tvarka</option>
                <option value="title_asc">Pavadinimas (A–Ž)</option>
                <option value="title_desc">Pavadinimas (Ž–A)</option>
                <option value="year_asc">Metai (seniausios pirmiau)</option>
                <option value="year_desc">Metai (naujausios pirmiau)</option>
            </select>
        </div>
    
    </div>
</form>

<div id="results">
    <p>Įveskite paieškos žodį.</p>
</div>

<script src="~/js/books.js" asp-append-version="true"></script>