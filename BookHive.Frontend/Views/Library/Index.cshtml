@model List<BookHive.Models.LibraryBook>

<h1>My Library</h1>

@if (Model.Count == 0)
{
    <p>Your library is empty.</p>
}
else
{
    @foreach (var libraryBook in Model)
    {
        <div>
            <h3>@libraryBook.OpenLibraryBookId</h3>
            <p>Status: @libraryBook.Status</p>

            @if (libraryBook.IsFavorite)
            {
                <p>Favorite❤️</p>
            }
            
            @if (libraryBook.Status != ReadingStatus.Read)
            {
                <form asp-action="MarkAsRead" method="post">
                    <input type="hidden" name="bookId" value="@libraryBook.OpenLibraryBookId" />
                    <button type="submit">Mark as read ✓</button>
                </form>
            }
            else
            {
                <p>✓ Read</p>
            }
        </div>
    }
}