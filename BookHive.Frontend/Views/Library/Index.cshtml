@model List<BookHive.Models.LibraryBook>

<h1>My Library</h1>

@if (Model.Count == 0)
{
    <p>Your library is empty.</p>
}
else
{
    @foreach (var libraryBook in Model)
    {
        <div>
            <h3>@libraryBook.Book.Title</h3>
            <p>Author: @libraryBook.Book.Author</p>
            <p>Status: @libraryBook.Status</p>

            @if (libraryBook.IsFavorite)
            {
                <p>Favorite❤️</p>
            }
        </div>
    }
}