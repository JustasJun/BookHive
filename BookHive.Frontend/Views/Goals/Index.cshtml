@model BookHive.Frontend.Models.GoalsPageViewModel
@using BookHive.Models

@{
    ViewData["Title"] = "Reading Goals";
    var current = Model.Current;
    bool showForm = current == null || ViewData["Edit"] as bool? == true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/goals.css" asp-append-version="true" />
}

<div class="goals-page">

    <div class="goals-header">
        <h1>Reading Goals</h1>

        @if (showForm)
        {
            <p>
                Set a goal, keep track of your progress,
                and fill your days with great stories. ♡
            </p>
        }
        else
        {
            <p>
                Every book is another story, another adventure,
                and another step toward your reading goal.
            </p>
        }
    </div>

    @if (showForm)
    {
        <div class="goals-card">

            <div class="goals-image">
                <img src="/images/reading-books.png" alt="Stack of books" />
            </div>

            <div class="goals-content">

                <h2>Let's set your reading goal 🌿</h2>

                <p class="description">
                    Choose how many books you'd like to read and for how long.
                    Your progress is counted from the moment you set the goal.
                </p>

                <form asp-action="SetGoal" method="post">

                    <div class="goal-form-group">
                        <label for="period">Time period</label>
                        <select id="period" name="period">
                            @foreach (var p in Enum.GetValues<GoalPeriod>())
                            {
                                <option value="@p" selected="@(p == GoalPeriod.OneMonth)">@p.Label()</option>
                            }
                        </select>
                    </div>

                    <div class="goal-form-group">
                        <label for="targetBooks">Target books</label>
                        <input type="number" id="targetBooks" name="targetBooks"
                               min="1" placeholder="e.g. 3" required />
                    </div>

                    <button type="submit" class="goal-button">Set My Goal 📖</button>

                    @if (current != null)
                    {
                        <a asp-action="Index" class="goal-cancel">Cancel</a>
                    }

                </form>

            </div>
        </div>
    }
    else
    {
        <div class="goal-result">

            <h2>@current!.Period.Label() Reading Goal 📚</h2>

            <p class="goal-stat">Target: <strong>@current.TargetBooks books</strong></p>
            <p class="goal-stat">Books read: <strong>@current.BooksRead</strong></p>
            <p class="goal-stat">Progress: <strong>@current.Percentage.ToString("0.##")%</strong></p>

            @if (current.Status == GoalStatus.Active)
            {
                <p class="goal-stat">
                    Ends: <strong>@current.EndsAt.ToString("yyyy-MM-dd")</strong>
                    · <strong>@current.DaysLeft @(current.DaysLeft == 1 ? "day" : "days") left</strong>
                </p>
                <p class="goal-stat">Expected by now: <strong>@current.ExpectedByNow</strong></p>
                <p class="goal-stat">Pace difference: <strong>@current.PaceDifference</strong></p>
                <p class="goal-not-completed">Keep reading — every book gets you closer. 🌿</p>
            }
            else if (current.Status == GoalStatus.Completed)
            {
                <p class="goal-completed">🎉 You reached your reading goal! Keep going!</p>
            }
            else
            {
                <p class="goal-not-completed">
                    Time ran out before you reached the target. It's saved in your history. 🌿
                </p>
            }

            <a asp-action="Index" asp-route-edit="true" class="goal-link-button">
                @(current.Status == GoalStatus.Active ? "Change goal" : "Set a new goal 🎯")
            </a>

        </div>
    }

    <div class="goal-history">
        <h2>Goal history</h2>

        @if (!Model.History.Any())
        {
            <p class="goal-history-empty">No finished goals yet. Your completed and missed goals will show up here.</p>
        }
        else
        {
            @foreach (var item in Model.History)
            {
                bool completed = item.Status == GoalStatus.Completed;
                int percent = (int)Math.Min(100, Math.Round(item.BooksRead * 100.0 / item.TargetBooks));

                <div class="history-item">
                    <div class="history-item__top">
                        <strong>@item.Period.Label() goal</strong>
                        <span class="history-badge @(completed ? "history-badge--completed" : "history-badge--missed")">
                            @(completed ? "✅ Completed" : "⌛ Not reached")
                        </span>
                    </div>

                    <p class="history-item__count">@item.BooksRead of @item.TargetBooks books · @percent%</p>

                    <div class="history-bar">
                        <div class="history-bar__fill" style="width:@(percent)%"></div>
                    </div>

                    <p class="history-item__date">
                        @item.StartedAt.ToString("yyyy-MM-dd") → @item.FinishedAt.ToString("yyyy-MM-dd")
                    </p>
                </div>
            }
        }
    </div>

</div>