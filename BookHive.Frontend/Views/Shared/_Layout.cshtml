<!DOCTYPE html>
<html lang="lt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookHive</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)

</head>
<body>
    <header class="main-header">
        <div class="header-content">
            <a asp-controller="Home" asp-action="Index" class="brand-logo">BookHive</a>
            <nav class="nav-menu">
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-search-nav" data-search-url="@Url.Action("SearchUsers", "Profile")">
                        <label class="visually-hidden" for="user-search-input">Search users</label>
                        <input id="user-search-input"
                               class="user-search-input"
                               type="search"
                               placeholder="Search users"
                               autocomplete="off"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-controls="user-search-results"
                               aria-expanded="false" />
                        <div id="user-search-results"
                             class="user-search-results"
                             role="listbox"
                             aria-label="User search results"
                             hidden></div>
                        <span class="visually-hidden"
                              id="user-search-status"
                              role="status"
                              aria-live="polite"></span>
                    </div>
                }
                <a asp-controller="Feed" asp-action="Index">Feed</a>
                <a asp-controller="Community" asp-action="Index">Community</a>
                <a asp-controller="Books" asp-action="Index">Book search</a>
                <a asp-controller="Home" asp-action="About">About us</a>
                <div class="profile-zone">
                    <a asp-controller="Account" asp-action="UserAccount" class="profile-link">Profile</a>

                    <div class="profile-dropdown">
                        <a asp-controller="Account" asp-action="UserAccount">My profile</a>
                        <a asp-controller="Library" asp-action="Index">My books</a>
                        <a asp-controller="Reviews" asp-action="UserPosts">My posts</a>
                        <a asp-controller="Goals" asp-action="Index">My goals</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit">Log out</button>
                        </form>
                    </div>
                </div>
            </nav>
        </div>
    </header>
    <main class="container py-5">
        @RenderBody()
    </main>
    <footer class="main-footer">
        <p>&copy; 2026 BookHive.</p>
    </footer>

    <partial name="_GoalToast" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/userSearch.js" asp-append-version="true"></script>
    }

</body>
</html>