@{
    ViewData["Title"] = "Registracija";
    Layout = "_LayoutAnonymous";
}
@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

<div class="auth-container">
    <h2 class="auth-title">Registration</h2>
    <p class="auth-subtitle">By creating an account, you will be able to use all features</p>

    <form asp-controller="Account" asp-action="Register" method="post" class="auth-form">
        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" class="form-input" placeholder="Username" />
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="example@email.com" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" />
        </div>

        <div class="auth-actions">
            <button type="submit" class="btn-primary">Register</button>
        </div>
    </form>

    <div class="auth-footer-links">
        Already have an account? <a asp-action="Login">Sign in</a>
    </div>
</div>