@{
    ViewData["Title"] = "Prisijungimas";
    Layout = "_LayoutAnonymous";
}
@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-container">
    <h2 class="auth-title">Prisijungimas</h2>
    <p class="auth-subtitle">Įveskite savo duomenis</p>

    <form asp-controller="Account" asp-action="Login" method="post" class="auth-form">
        <div class="form-group">
            <label for="email">El. paštas</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="pavyzdys@email.com" />
        </div>

        <div class="form-group">
            <label for="password">Slaptažodis</label>
            <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" />
        </div>

        <div class="auth-actions">
            <button type="submit" class="btn-primary">Prisijungti</button>
        </div>
    </form>

    <div class="auth-footer-links">
        Nematote paskyros? <a asp-action="Register">Registruokitės</a>
    </div>
</div>