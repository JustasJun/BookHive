@{
    ViewData["Title"] = "Prisijungimas";
    Layout = "_LayoutAnonymous";
}
@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

@if (ViewBag.Error != null)
{
    <p>@ViewBag.Error</p>
}

<div class="auth-container">
    <h2 class="auth-title">Login</h2>
    <p class="auth-subtitle">Enter your credentials</p>

    <form asp-controller="Account" asp-action="Login" method="post" class="auth-form">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="example@email.com" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" />
        </div>

        <div class="auth-actions">
            <button type="submit" class="btn-primary">Login</button>
        </div>
    </form>

    <div class="auth-footer-links">
        Don't have an account? <a asp-action="Register">Register</a>
    </div>
</div>